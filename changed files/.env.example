# ── LLM Configuration (single source of truth for all agents & crew manager) ──
# Model used by all CrewAI agents AND the hierarchical crew manager.
# Supports any model string that LiteLLM recognises, e.g.:
#   gpt-4o-mini, gpt-4o, gpt-4-turbo,
#   gemini/gemini-2.0-flash, anthropic/claude-sonnet-4-20250514
CREWAI_MODEL=gpt-4o-mini

# ── API Keys (set the one matching your chosen model provider) ────────────────
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Agent Iteration Limits ────────────────────────────────────────────────────
# Max iterations each agent may perform before returning (lower = faster).
MAX_AGENT_ITER=5
# Max requests-per-minute for the entire crew (rate limiting).
MAX_CREW_RPM=30

# ── A2A / Server ─────────────────────────────────────────────────────────────
PORT=8003
ORCHESTRATOR_URL=http://localhost:8003
# BASE_URL=http://localhost:8003

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for X-API-Key header authentication.
# API_KEYS=my-key-1,my-key-2
# Or use individual key env vars:
# API_KEY_PRIMARY=my-key-1
# API_KEY_SECONDARY=my-key-2

# ── FHIR / Prompt Opinion ────────────────────────────────────────────────────
# PO_PLATFORM_BASE_URL=http://localhost:5139

# ── RAG (ChromaDB) ───────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Debugging ─────────────────────────────────────────────────────────────────
# LOG_FULL_PAYLOAD=true
# LOG_HOOK_RAW_OBJECTS=false
